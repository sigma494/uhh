export type WidgetOpts = {
	id?: string, label?: string, parent?: any,
	value?: any, text?: string, placeholder?: string,
	min?: number, max?: number, step?: number,
	options?: {string}, variant?: "primary"|"secondary"|"ghost"|"outline"|"danger"|"success",
	width?: number, height?: number, size?: number,
	onChange?: (value: any) -> (), onClose?: () -> (),
	color?: Color3, textColor?: Color3,
	transparency?: number, textTransparency?: number,
	glow?: boolean, glowColor?: Color3,
	chroma?: boolean, chromaOffset?: number,
	duration?: number,
}

export type Window = {
	Title: (self: Window, text: string) -> Window,
	Collapsible: (self: Window, b: boolean) -> Window,
	Closable: (self: Window, b: boolean) -> Window,
	Resizable: (self: Window, b: boolean) -> Window,
	Draggable: (self: Window, b: boolean) -> Window,
	SnapToEdges: (self: Window, b: boolean) -> Window,
	Position: (self: Window, x: number, y: number) -> Window,
	Size: (self: Window, w: number, h: number) -> Window,
	MinSize: (self: Window, w: number, h: number) -> Window,
	Scrollable: (self: Window, b: boolean) -> Window,
	Footer: (self: Window, renderFn: () -> ()) -> Window,
	Header: (self: Window, renderFn: () -> ()) -> Window,
	Tab: (self: Window, name: string, options?: WidgetOpts) -> any,
	Group: (self: Window, name: string, options?: WidgetOpts) -> any,
	Separator: (self: Window, text?: string) -> any,
	Label: (self: Window, text: string) -> any,
	Spacer: (self: Window, h: number) -> any,
	SameLine: (self: Window) -> Window,
	Indent: (self: Window, n: number) -> Window,
	Columns: (self: Window, n: number) -> Window,
