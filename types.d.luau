export type Gui = {
	new: (options?: {theme?: string|Theme, parent?: any, scale?: number, accent?: Color3, persist?: boolean, persistKey?: string, reducedMotion?: boolean|string, dev?: boolean}) -> Gui,
	Window: (self: Gui, id: string, options?: WidgetOpts) -> Window,
	TabBar: (self: Gui, id: string, options?: WidgetOpts) -> any,
	Notify: (self: Gui, text: string, options?: WidgetOpts) -> any,
	Modal: (self: Gui, id: string, options?: WidgetOpts) -> Group,
	ContextMenu: (self: Gui, id: string, options?: WidgetOpts) -> Group,
	Tooltip: (self: Gui, text: string, anchor: any) -> Gui,
	SetTheme: (self: Gui, theme: string|Theme) -> Gui,
	GetTheme: (self: Gui) -> Theme,
	PatchTheme: (self: Gui, partialTheme: Theme) -> Gui,
	ResetTheme: (self: Gui) -> Gui,
	ExportTheme: (self: Gui, format?: string) -> string,
	ImportTheme: (self: Gui, spec: string|Theme) -> Gui,
	Save: (self: Gui, slot?: string) -> Gui,
	Load: (self: Gui, slot?: string) -> Gui,
	ClearSlots: (self: Gui) -> Gui,
	SetScale: (self: Gui, n: number) -> Gui,
	Destroy: (self: Gui) -> Gui,
	On: (self: Gui, event: string, handler: () -> ()) -> Gui,
	Off: (self: Gui, event: string, handler: () -> ()) -> Gui,
}

export type Themes = {
	[name: string]: Theme,
}

return {} :: Gui
